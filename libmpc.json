{
    "name": "libmpc",
    "version": "1.0.1",
    "description": "Musepack decoder",
    "filters":["mpcdec"],
    "help": "This filter decodes Musepack (.mpc, stream versions 7 and 8) audio using libmpcdec.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libmpc.accessor",
    "filter_source":{
        "mpcdec" : "dec_mpc.c"
    },
    "extension":{
      "mpc" : "audio",
      "mpp" : "audio"
    },
    "using": ["solver_minimal_1", "solver_1"],
    "patents": {
        "status": "royalty-free",
        "note": "Musepack",
        "checked": "2026-10-16"
    }
}
